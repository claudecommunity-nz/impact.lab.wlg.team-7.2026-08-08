# Data files are NOT committed — they belong to their publishers (see per-source
# READMEs) and are large. Only definitions, scripts and docs live in this repo.
*.duckdb
*.duckdb.wal
*.csv
*.tsv
*.parquet
raw/
data/transport_sensors/

# Exception: committed derived AGGREGATE data (not raw WCC data) for the anomaly layers
!data/sensors/anomaly/csv/
!data/sensors/anomaly/csv/*.csv
!data/buses_trains/anomaly/csv/
!data/buses_trains/anomaly/csv/*.csv
!NZTA/anomaly/csv/
!NZTA/anomaly/csv/*.csv
!data/combined/csv/
!data/combined/csv/*.csv

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Build / local output
artifacts/local/
node_modules/
site/dist/
.wrangler/

# Streamlit app runtime data (captured camera frames, manifest, catalogue)
streamlit/*/data/
*.jpg

# Local / editor cruft
.DS_Store
Thumbs.db
*.log

# Secrets never belong in this public repo. Agent/provider API keys live in the
# visitor's browser localStorage only; anything key-shaped on disk stays local.
# (site/tests also scan the source for key-shaped strings and fail the build.)
.env
.env.*
*.env
*.key
*.pem
secrets/
murmur-settings.json

# Register and SUBSCRIBE at https://opendata.metlink.org.nz/ - the key is inert until you subscribe
METLINK_API_KEY=your_key_here

# Optional - improves the chance of finding an April 2026 static snapshot
TRANSITLAND_API_KEY=

# Poll cadence for the realtime archiver, seconds. 20-30 is the published feed rate.
RT_POLL_SECONDS=25
